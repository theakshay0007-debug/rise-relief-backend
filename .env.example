# Copy this file to .env and fill in real values.
# Never commit the real .env file to a public repository.

# Connection string from your Postgres provider (Neon, Supabase, Render, etc.)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# A long random string used to sign admin login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# The exact URL your website is served from (protects your API from being
# called by other sites). Example: https://riseandrelieffoundation.in
FRONTEND_ORIGIN=https://your-site-url-here

# Razorpay API keys (from your Razorpay Dashboard → Settings → API Keys).
# Test-mode keys work immediately with no KYC — perfect for trying this out.
# RAZORPAY_KEY_ID is also used by the website's frontend (it's meant to be
# public). RAZORPAY_KEY_SECRET must stay here on the server only — never put
# it in the website's code.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Resend (resend.com) sends the 80G certificate email. Free tier is generous.
# Sign up, then get an API key from Dashboard → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Until you verify your own domain in Resend, you can only send FROM this
# address and only TO the email you signed up to Resend with — fine for
# testing, but you must verify a real domain (e.g. riseandrelieffoundation.in)
# in Resend before donor emails can actually be delivered to donors.
FROM_EMAIL=onboarding@resend.dev

# IMPORTANT — these appear printed on the 80G certificate PDF. Leaving them
# as-is prints "NOT YET CONFIGURED" on the certificate instead of a fake
# number, since an invented registration number would be a real legal
# problem. Replace with your foundation's actual government-issued values
# before this goes live.
NGO_80G_REG_NO=NOT YET CONFIGURED
NGO_PAN=NOT YET CONFIGURED

# Port the server listens on (most hosts set this automatically; safe to leave)
PORT=3000
